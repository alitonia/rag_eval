%% vnchars.sty -- Vietnamese UTF-8 characters via native T5 Type-1 glyphs
%% with an automatic T1 composite fallback on minimal TeX installs.
%%
%% v1.0 (2026-11-20):
%%   When T5 encoding (`t5enc.def`) and a T5 Times font (`t5ptm.fd` or TeX Gyre
%%   Termes `t5qtm.fd`) are present, load `fontenc` with `[T5,T1]` (keeping `T1`
%%   as the document default for English prose), alias IEEEtran's PostScript
%%   families (`ptm`, `phv`, `pcr`) to `qtm`/`qhv`/`qcr` when `t5p*.fd` are
%%   absent, and dispatch every Vietnamese UTF-8 codepoint directly to its
%%   precomposed T5 glyph via `\vn@tfive`. This eliminates split horns, detached
%%   hook-above accents, and broken `T1/ptm` `\dj` bars.
%%
%%   When native T5 fonts are unavailable, retain the v0.3 T1 composite
%%   definitions as an emergency fallback (and stay a no-op if `vntex`/`babel`
%%   already defined `\h`, `\ohorn`, `\uhorn`).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{vnchars}[2026/11/20 v1.0 Vietnamese characters via T5 or T1 composites]

\newif\ifvn@native@tfive
\vn@native@tfivefalse
\IfFileExists{t5enc.def}{%
  \IfFileExists{t5ptm.fd}{\vn@native@tfivetrue}{%
    \IfFileExists{t5qtm.fd}{\vn@native@tfivetrue}{}%
  }%
}{}

\ifvn@native@tfive
  \RequirePackage[T5,T1]{fontenc}

  % Silence IEEEtran \scshape+\emph (`T1/ptm/m/scit`) undefined warning and
  % ensure T5 `scit` matches T1/ptm's lowercase italic fallback inside table captions.
  \IfFileExists{t1ptm.fd}{%
    \@ifundefined{T1+ptm}{\InputIfFileExists{t1ptm.fd}{}{}}{}%
    \@ifundefined{T1/ptm/m/scit}{\DeclareFontShape{T1}{ptm}{m}{scit}{<->ssub*ptm/m/it}{}}{}%
  }{}%

  % Map IEEEtran's `ptm`/`phv`/`pcr` families onto TeX Gyre T5 families
  % (`qtm`, `qhv`, `qcr`) whenever standard `vntex` `t5p*.fd` files are absent.
  % Note: NFSS `ssub` requires the target `.fd` family to be loaded first.
  \IfFileExists{t5ptm.fd}{}{%
    \InputIfFileExists{t5qtm.fd}{}{}%
    \DeclareFontFamily{T5}{ptm}{}%
    \DeclareFontShape{T5}{ptm}{m}{n}{<->ssub*qtm/m/n}{}%
    \DeclareFontShape{T5}{ptm}{m}{it}{<->ssub*qtm/m/it}{}%
    \DeclareFontShape{T5}{ptm}{m}{sl}{<->ssub*qtm/m/it}{}%
    \DeclareFontShape{T5}{ptm}{m}{sc}{<->ssub*qtm/m/sc}{}%
    \DeclareFontShape{T5}{ptm}{m}{scit}{<->ssub*qtm/m/it}{}%
    \DeclareFontShape{T5}{ptm}{m}{scsl}{<->ssub*qtm/m/it}{}%
    \DeclareFontShape{T5}{ptm}{b}{n}{<->ssub*qtm/b/n}{}%
    \DeclareFontShape{T5}{ptm}{b}{it}{<->ssub*qtm/b/it}{}%
    \DeclareFontShape{T5}{ptm}{b}{sl}{<->ssub*qtm/b/it}{}%
    \DeclareFontShape{T5}{ptm}{b}{sc}{<->ssub*qtm/b/sc}{}%
    \DeclareFontShape{T5}{ptm}{b}{scit}{<->ssub*qtm/b/it}{}%
    \DeclareFontShape{T5}{ptm}{b}{scsl}{<->ssub*qtm/b/it}{}%
    \DeclareFontShape{T5}{ptm}{bx}{n}{<->ssub*qtm/b/n}{}%
    \DeclareFontShape{T5}{ptm}{bx}{it}{<->ssub*qtm/b/it}{}%
    \DeclareFontShape{T5}{ptm}{bx}{sl}{<->ssub*qtm/b/it}{}%
    \DeclareFontShape{T5}{ptm}{bx}{sc}{<->ssub*qtm/b/sc}{}%
    \DeclareFontShape{T5}{ptm}{bx}{scit}{<->ssub*qtm/b/it}{}%
    \DeclareFontShape{T5}{ptm}{bx}{scsl}{<->ssub*qtm/b/it}{}%
  }%
  \IfFileExists{t5phv.fd}{}{%
    \IfFileExists{t5qhv.fd}{%
      \InputIfFileExists{t5qhv.fd}{}{}%
      \DeclareFontFamily{T5}{phv}{}%
      \DeclareFontShape{T5}{phv}{m}{n}{<->ssub*qhv/m/n}{}%
      \DeclareFontShape{T5}{phv}{m}{it}{<->ssub*qhv/m/it}{}%
      \DeclareFontShape{T5}{phv}{m}{sl}{<->ssub*qhv/m/it}{}%
      \DeclareFontShape{T5}{phv}{m}{sc}{<->ssub*qhv/m/sc}{}%
      \DeclareFontShape{T5}{phv}{b}{n}{<->ssub*qhv/b/n}{}%
      \DeclareFontShape{T5}{phv}{b}{it}{<->ssub*qhv/b/it}{}%
      \DeclareFontShape{T5}{phv}{b}{sl}{<->ssub*qhv/b/it}{}%
      \DeclareFontShape{T5}{phv}{bx}{n}{<->ssub*qhv/b/n}{}%
      \DeclareFontShape{T5}{phv}{bx}{it}{<->ssub*qhv/b/it}{}%
      \DeclareFontShape{T5}{phv}{bx}{sl}{<->ssub*qhv/b/it}{}%
    }{}%
  }%
  \IfFileExists{t5pcr.fd}{}{%
    \IfFileExists{t5qcr.fd}{%
      \InputIfFileExists{t5qcr.fd}{}{}%
      \DeclareFontFamily{T5}{pcr}{}%
      \DeclareFontShape{T5}{pcr}{m}{n}{<->ssub*qcr/m/n}{}%
      \DeclareFontShape{T5}{pcr}{m}{it}{<->ssub*qcr/m/it}{}%
      \DeclareFontShape{T5}{pcr}{m}{sl}{<->ssub*qcr/m/it}{}%
      \DeclareFontShape{T5}{pcr}{b}{n}{<->ssub*qcr/b/n}{}%
      \DeclareFontShape{T5}{pcr}{b}{it}{<->ssub*qcr/b/it}{}%
      \DeclareFontShape{T5}{pcr}{bx}{n}{<->ssub*qcr/b/n}{}%
      \DeclareFontShape{T5}{pcr}{bx}{it}{<->ssub*qcr/b/it}{}%
    }{}%
  }%

